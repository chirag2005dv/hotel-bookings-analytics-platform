# .env.example
# ============
# Environment variables for the Hotel Bookings Analytics Platform (Phase 8).
#
# SETUP:
#   1. Copy this file to .env in the project root:
#        cp .env.example .env          (macOS / Linux)
#        copy .env.example .env        (Windows)
#   2. Fill in your actual API key below.
#   3. Never commit .env to version control (it is in .gitignore).
#
# The dashboard reads these with python-dotenv (load_dotenv() in ai_insights.py).
# Existing shell environment variables always take priority over .env values.

# ── OpenAI API Key (required for AI Insights tab) ───────────────────────────
# Obtain from: https://platform.openai.com/api-keys
# The key must have access to the Chat Completions API.
OPENAI_API_KEY=sk-...your-key-here...

# ── OpenAI Model (optional, default: gpt-4o-mini) ───────────────────────────
# Override to use a different model. Options: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# gpt-4o-mini is recommended for cost-efficiency on analytics summaries.
# OPENAI_MODEL=gpt-4o-mini

# ── AI Request Timeout (optional, default: 30 seconds) ──────────────────────
# Increase if you experience frequent timeouts on slow connections.
# AI_TIMEOUT=30
